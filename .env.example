# Live generation needs an LLM. Everything else (library, MCP, card) works without it.
# Cloudflare Workers AI, free tier: 10,000 Neurons/day. Account ID is in the dashboard URL.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Extraction model and a second, different family for the verifier pass.
LLM_MODEL_EXTRACT=@cf/openai/gpt-oss-120b
LLM_MODEL_VERIFY=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Search: exa | tavily | none. With "none" the agent only reads URLs you hand it.
SEARCH_PROVIDER=exa
EXA_API_KEY=
TAVILY_API_KEY=

# Optional: public base URL used in share links and the MCP card (defaults to the request origin).
PUBLIC_BASE_URL=
